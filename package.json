{
  "name": "sigacq",
  "version": "1.0.0",
  "private": true,
  "description": "Continuous multi-channel biosignal acquisition, recording, retrieval and playback",
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "bin": {
    "sigctl": "bin/sigctl.ts",
    "sigval": "bin/sigval.ts"
  },
  "scripts": {
    "start": "node bin/uiserver.ts",
    "demo": "bash scripts/demo.sh",
    "record": "node bin/recorder.ts",
    "generate": "node bin/generator.ts",
    "validate": "node bin/sigval.ts",
    "test": "node --test-concurrency=1 --test test/*.test.ts",
    "test:faults": "node bench/write-stall.ts && node bench/stalled-consumer.ts --stall 8 --duration 24",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "ui:build": "node ui/build.ts",
    "ui:watch": "node ui/build.ts --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
